# Fill after (주)리치몬드인터내셔널 PG merchant contract
NEXT_PUBLIC_PG_PROVIDER=none
NEXT_PUBLIC_PG_CLIENT_KEY=
NEXT_PUBLIC_PG_MID=
PG_SECRET_KEY=
NEXT_PUBLIC_NAVERPAY=false
NEXT_PUBLIC_KAKAOPAY=false

# --- Naver Pay 주문형 V2.1 (독립몰) — sandbox first ---
# Feature flag: set true to force-show button; omit/false + no button key hides it.
NEXT_PUBLIC_NAVERPAY_ORDER=false
# Sandbox/test until final 검수 승인. Set false only after production approval.
NEXT_PUBLIC_NAVERPAY_SANDBOX=true
# Public site origin (product XML / image / info URLs)
NEXT_PUBLIC_SITE_URL=https://briq.kr
# 네이버공통인증키 (wcs Account ID) — public
NEXT_PUBLIC_NAVER_WCS_ACCOUNT=
# 버튼 인증키 — required by client SDK (public by design)
NEXT_PUBLIC_NAVERPAY_BUTTON_KEY=
# 상점 ID / 페이센터 shop id — server only
NAVERPAY_MERCHANT_ID=
# 가맹점인증키 (certiKey) — SERVER ONLY, never NEXT_PUBLIC_
NAVERPAY_CERTI_KEY=

# Optional returnInfo overrides (defaults: SiteFooter 김포 사업장 / (주)리치몬드인터내셔널)
# NAVERPAY_RETURN_ZIPCODE=10066
# NAVERPAY_RETURN_ADDRESS1=경기도 김포시 고촌읍 은행영사정로23번길 46
# NAVERPAY_RETURN_ADDRESS2=(주)리치몬드인터내셔널 / Briq
# NAVERPAY_RETURN_SELLERNAME=(주)리치몬드인터내셔널
# NAVERPAY_RETURN_CONTACT1=447897535888

# Support email alerts (reviews, paid orders) → support@hjstoryltd.com
# Create a free key at https://resend.com then verify a sending domain.
RESEND_API_KEY=
MAIL_FROM="Briq <noreply@your-verified-domain.com>"
MAIL_TO_SUPPORT=support@hjstoryltd.com

# Staff admin (Q&A replies). Defaults: admin@briq.kr / BriqAdmin2026!
NEXT_PUBLIC_ADMIN_EMAIL=admin@briq.kr
NEXT_PUBLIC_ADMIN_PASSWORD=BriqAdmin2026!

# --- Search / SEO (Naver Search Advisor + optional Google) ---
# Paste the meta verification code value from https://searchadvisor.naver.com
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
