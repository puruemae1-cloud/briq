description: Keep briq.kr homepage and root layout static (ISR) — never per-request SSR
globs: src/app/layout.tsx,src/app/page.tsx,src/components/SiteHeader.tsx,src/components/SiteFooter.tsx,src/lib/cart-*.ts
alwaysApply: false
