{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash scripts/vercel-skip-stale.sh",
  "regions": ["icn1"],
  "functions": {
    "src/app/api/products/shop/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/products/by-ids/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/qa/auto-reply/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/home-rotate/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/qa/auto-reply",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/home-rotate",
      "schedule": "0 13 * * *"
    }
  ]
}
